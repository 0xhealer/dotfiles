[global]
    monitor = 0
    follow = mouse
    width = (250, 350)
    height = (0, 200)
    origin = top-right
    offset = (16, 16)
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 8
    corner_radius = 8
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    show_age_threshold = 60
    sort = yes
    idle_threshold = 120
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2eD9"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 5

[urgency_normal]
    background = "#1e1e2eD9"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 8

[urgency_critical]
    background = "#1e1e2eD9"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
