{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "",
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#212}—{#}",
    },
    {
      "type": "title",
      "key": "{#}",
      "format": "{host-name}",
      "outputColor": "1;97",
    },
    {
      "type": "kernel",
      "key": "{#}",
      "format": "{release}",
      "outputColor": "97",
    },
    {
      "type": "localip",
      "key": "{#}",
      "showPrefixLen": false,
      "format": "{ipv4}",
      "outputColor": "97",
    },
    {
      "type": "wm",
      "key": "{#}",
      "format": "{pretty-name}",
      "outputColor": "114",
    },
    {
      "type": "shell",
      "key": "{#}",
      "format": "{exe-name} {version}",
      "outputColor": "213",
    },
    {
      "type": "custom",
      "format": "{#212}—{#}",
    },
  ],
}
