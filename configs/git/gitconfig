[include]
    path = ~/.gitconfig.local

# GitHub over HTTPS uses the gh login (gh auth login), so there is no password prompt
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = less -FRX
    autocrlf = input

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[rerere]
    enabled = true

[alias]
    st = status -sb
    lg = log --oneline --graph --decorate
    last = log -1 HEAD --stat
    unstage = reset HEAD --
