@import "~/.config/matugen/generated/rofi-colors.rasi"

* {
  background-color: transparent;
  text-color:       @fg;
  margin:  0;
  padding: 0;
  spacing: 0;
}

window {
  location: center;
  width: 640px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 12px;
}

mainbox {
  padding: 12px;
  children: [ inputbar, listview ];
  spacing: 10px;
}

inputbar {
  padding: 10px 14px;
  spacing: 10px;
  background-color: @bg-alt;
  border-radius: 8px;
  children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry  { placeholder: "Search"; placeholder-color: @fg-dim; }

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 4px;
}

element {
  padding: 8px 12px;
  spacing: 10px;
  border-radius: 8px;
}

element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { size: 1.2em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
