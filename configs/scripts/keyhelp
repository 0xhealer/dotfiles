#!/usr/bin/env bash
wm=i3
[[ -n "${SWAYSOCK:-}" ]] && wm=sway
conf="${XDG_CONFIG_HOME:-$HOME/.config}/$wm/config"
# shellcheck disable=SC2016
filter='s/^[[:space:]]*bindsym[[:space:]]+//; s/--no-startup-id //; s/\$mod/Super/g; s/exec //'
grep -E '^[[:space:]]*bindsym' "$conf" | sed -E "$filter" |
  rofi -dmenu -i -p "Keys" -theme-str 'window {width: 70%;} listview {lines: 18;}' >/dev/null
