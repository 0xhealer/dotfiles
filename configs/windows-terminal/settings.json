{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": "find",
      "id": "User.find"
    },
    {
      "command": {
        "action": "copy",
        "singleLine": false
      },
      "id": "User.copy"
    },
    {
      "command": "paste",
      "id": "User.paste"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "auto",
        "splitMode": "duplicate"
      },
      "id": "User.split"
    },
    {
      "command": "togglePaneZoom",
      "id": "User.zoom"
    }
  ],
  "copyFormatting": "none",
  "copyOnSelect": true,
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "firstWindowPreference": "defaultProfile",
  "keybindings": [
    {
      "id": "User.copy",
      "keys": "ctrl+shift+c"
    },
    {
      "id": "User.paste",
      "keys": "ctrl+shift+v"
    },
    {
      "id": "User.split",
      "keys": "alt+shift+d"
    },
    {
      "id": "User.find",
      "keys": "ctrl+shift+f"
    },
    {
      "id": "User.zoom",
      "keys": "ctrl+shift+z"
    },
    {
      "id": null,
      "keys": "alt+up"
    },
    {
      "id": null,
      "keys": "alt+down"
    },
    {
      "id": null,
      "keys": "alt+left"
    },
    {
      "id": null,
      "keys": "alt+right"
    },
    {
      "id": null,
      "keys": "alt+shift+up"
    },
    {
      "id": null,
      "keys": "alt+shift+down"
    },
    {
      "id": null,
      "keys": "alt+shift+left"
    },
    {
      "id": null,
      "keys": "alt+shift+right"
    }
  ],
  "launchMode": "focus",
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  "profiles": {
    "defaults": {
      "antialiasingMode": "cleartype",
      "colorScheme": "Catppuccin Mocha",
      "cursorShape": "bar",
      "font": {
        "face": "JetBrainsMono Nerd Font, Hack Nerd Font",
        "size": 12
      },
      "opacity": 85,
      "padding": "8",
      "scrollbarState": "hidden",
      "useAcrylic": true
    },
    "list": [
      {
        "commandline": "pwsh.exe -NoLogo",
